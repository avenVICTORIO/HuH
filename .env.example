# Kopieren nach .env und Werte eintragen (Datei bleibt lokal, ist gitignored).

# KI im Team-Chat (Phala)
PHALA_API_KEY=
KI_MODELL=qwen/qwen3.8-27b

# Docker-Stack (docker compose): Postgres-Zugang + Port der App auf dem Host
POSTGRES_DB=huh
POSTGRES_USER=huh
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_PORT=5432
APP_PORT=3000

# Nur Produktion (docker-compose.prod.yml): Domain für automatisches HTTPS + Image aus der Registry
# DOMAIN=app.example.com
# APP_IMAGE=ghcr.io/avenvictorio/huh:latest

# Ohne Docker lokal: leer lassen -> eingebettetes PGlite unter data/pg.
# DATABASE_URL=postgres://huh:huh@localhost:5432/huh
